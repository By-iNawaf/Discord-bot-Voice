# توكن بوت اللوحة (الذي يعرض الأزرار) — لا تشاركه مع أحد
DISCORD_TOKEN=
# معرّف مالك اللوحة (يمكن أكثر من معرّف مفصولين بفاصلة)
OWNER_ID=
# اختياري: روم اللوحة (أو استخدم الأمر /setup)
PANEL_CHANNEL_ID=
# اختياري: روم اللوق (أو حدده من اللوحة)
LOG_CHANNEL_ID=
# لا تعدل الموقع لكي لا يخرب البوت 
WEBSITE_URL=https://vault.bynawaf.xyz
# لغة اللوحة الافتراضية: ar أو en (يمكن تبديلها بزر من اللوحة)
DEFAULT_LANG=ar
# ملف توكنات البوتات الصوتية
TOKENS_FILE=./tokens.txt
# فاصل تسجيل دخول كل بوت بالمللي ثانية (لا تنزله كثيرًا) / عدد عمليات الدخول للصوت المتزامنة
LOGIN_GAP_MS=2500
JOIN_CONCURRENCY=3
# مكان قاعدة البيانات (يجب أن يكون على قرص دائم)
DB_PATH=./data/voice.sqlite
